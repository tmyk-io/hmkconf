{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hmkconf",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS",
  },
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },
}
